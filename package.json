{
  "name": "luma-editor",
  "version": "1.0.0",
  "description": "A local-first cross-platform text and Markdown editor",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "package:win": "npm run build && node scripts/package-windows.mjs"
  },
  "dependencies": {
    "@prettier/plugin-php": "0.25.0",
    "@prettier/plugin-xml": "3.4.2",
    "dompurify": "3.4.14",
    "lucide": "1.41.0",
    "marked": "18.0.11",
    "monaco-editor": "0.56.0",
    "prettier": "3.9.6",
    "prettier-plugin-java": "2.10.3",
    "prettier-plugin-toml": "2.0.6",
    "sql-formatter": "15.8.2"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@playwright/test": "1.63.0",
    "electron-builder": "26.0.12",
    "electron": "44.2.0",
    "electron-builder": "^26.0.12",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
